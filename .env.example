# Pigzel Environment Configuration
# Copy this file to .env and fill in values for your environment.
# Never commit .env or real API keys to version control.

# Application
PIGZEL_ENV=development
PIGZEL_LOG_LEVEL=INFO
PIGZEL_STORAGE_DIR=./outputs

# Model Gateway — LLM Provider (example placeholders)
PIGZEL_LLM_PROVIDER=
PIGZEL_LLM_API_KEY=
PIGZEL_LLM_BASE_URL=
PIGZEL_LLM_MODEL=

# Model Gateway — Image Provider (example placeholders)
PIGZEL_IMAGE_PROVIDER=
PIGZEL_IMAGE_API_KEY=
PIGZEL_IMAGE_BASE_URL=

# Model Gateway — Video Provider (example placeholders)
PIGZEL_VIDEO_PROVIDER=
PIGZEL_VIDEO_API_KEY=
PIGZEL_VIDEO_BASE_URL=

# Model Gateway — Audio Provider (example placeholders)
PIGZEL_AUDIO_PROVIDER=
PIGZEL_AUDIO_API_KEY=
PIGZEL_AUDIO_BASE_URL=
